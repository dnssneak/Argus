# Environment configuration template for Argus

# Database connection URL (PostgreSQL / Supabase / SQLite)
# Example: DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.xxx.supabase.co:6543/postgres
DATABASE_URL=sqlite:///backend/argus.db

# Cryptographic secret keys (Generate using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=YOUR_GENERATED_SECRET_KEY_HERE
SECURITY_SALT=YOUR_GENERATED_SECURITY_SALT_HERE

# Flask Debug Mode (Set to True only in local development)
FLASK_DEBUG=False
PORT=5001

# AI Remediation Advisor (LiteRouter / OpenRouter optional integration)
# OPENROUTER_API_KEY=your_openrouter_or_literouter_api_key_here
# LITE_ROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=gemma-3-27b-it:free
